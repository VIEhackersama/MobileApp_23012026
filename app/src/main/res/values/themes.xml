<resources>
    <color name="primary">#145C4C</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="ink">#19382F</color>
    <color name="muted">#5E7069</color>
    <color name="paper">#F5F5EF</color>
    <color name="line">#DCE3DB</color>
    <style name="Theme.FruitShop" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">#B9D5B7</item>
        <item name="colorSecondaryContainer">#DCEADB</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurfaceContainerHigh">#F0F3EA</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
