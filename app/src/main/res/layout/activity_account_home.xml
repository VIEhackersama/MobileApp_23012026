<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/app_name" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/customer_catalog" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/fruit_browse" android:visibility="gone" app:cornerRadius="14dp" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/customer_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardCornerRadius="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/Title" android:text="@string/fruit_selection_title" android:textSize="18sp" />
                    <TextView android:id="@+id/customer_selection_details" style="@style/Body" android:layout_marginTop="8dp" />
                    <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/fruit_selection_note" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/logout" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="@string/logout" app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
