<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="14dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="18dp"
    app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/admin_order_number" style="@style/OrderSection"
                android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/admin_order_status" style="@style/OrderStatus" />
        </LinearLayout>
        <TextView android:id="@+id/admin_order_date" style="@style/Body" android:textSize="12sp" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/admin_order_customer" style="@style/OrderSection" android:textSize="17sp" android:layout_marginTop="18dp" />
        <TextView android:id="@+id/admin_order_contact" style="@style/Body" android:textSize="14sp" android:layout_marginTop="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/order_item_surface"
            android:padding="12dp" android:layout_marginTop="14dp">
            <TextView android:id="@+id/admin_order_item_count" style="@style/Body" android:textSize="12sp" />
            <TextView android:id="@+id/admin_order_items_preview" style="@style/Body"
                android:textColor="@color/ink" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center_vertical">
            <TextView android:id="@+id/admin_order_amount" style="@style/OrderSection"
                android:layout_width="0dp" android:layout_weight="1" android:textSize="20sp" android:textColor="@color/primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/admin_order_view" android:textSize="13sp"
                android:textColor="@color/primary" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
