<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/fruit_count" style="@style/Body" android:paddingHorizontal="24dp"
        android:paddingVertical="12dp" android:text="@string/fruit_catalog" />
    <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="@string/fruit_search_hint"
        android:layout_marginHorizontal="24dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/fruit_search"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/fruit_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="20dp" android:paddingBottom="100dp" android:clipToPadding="false" />
        <TextView android:id="@+id/fruit_empty" style="@style/Body" android:layout_height="match_parent"
            android:gravity="center" android:padding="24dp" android:text="@string/fruit_empty"
            android:visibility="gone" />
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/fruit_add"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
            android:layout_margin="24dp" android:text="@string/fruit_add" app:icon="@drawable/ic_add" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
